RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
# Configure verified current India Post Retail Parcel rates before enabling postal checkout.
# JSON format: {"default":{"first500g":<INR>,"additional500g":<INR>,"gstPercent":<percent>},"states":{"State name":{"first500g":<INR>,"additional500g":<INR>,"gstPercent":<percent>}}}
INDIA_POST_RETAIL_RATES_JSON=
PORT=5500
ADMIN_LOGIN_ID=replace_with_unique_admin_id
ADMIN_PASSWORD=replace_with_a_long_random_password
ADMIN_ALLOWED_ORIGIN=https://www.janjeevan.store
APP_ALLOWED_ORIGINS=https://www.janjeevan.store,https://janjeevan.store
FIREBASE_PROJECT_ID=janjeevanstore
# Optional for local use; Firebase Functions use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Cloudflare R2 product image storage. Keep the secret access key private.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
