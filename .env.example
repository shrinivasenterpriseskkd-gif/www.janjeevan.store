RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace_with_your_key_secret
PORT=5500
ADMIN_LOGIN_ID=replace_with_unique_admin_id
ADMIN_PASSWORD=replace_with_a_long_random_password
# Set only when the Admin UI is hosted on a separate origin from this server.
ADMIN_ALLOWED_ORIGIN=https://www.janjeevan.store
# Exact comma-separated origins for customer and Delivery Partner pages hosted separately.
APP_ALLOWED_ORIGINS=https://www.janjeevan.store,https://janjeevan.store
FIREBASE_PROJECT_ID=janjeevanstore
# Optional JSON service-account credential for hosted environments; keep it secret and never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Configure Application Default Credentials on the server; never commit a service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-admin-service-account.json
# Cloudflare R2 product image storage. Keep the secret access key private.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Public HTTPS URL for the R2 bucket, preferably a custom domain.
CLOUDFLARE_R2_PUBLIC_URL=
